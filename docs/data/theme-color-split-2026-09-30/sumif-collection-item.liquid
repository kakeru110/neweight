{%- comment -%}
  コレクションの1商品ぶんを描画する（2026-09-30 / sumif）
  色オプションがあれば購入可能な色ごとに1枚。全サイズ売り切れの色はカードを出さない。
  色オプションが無い商品も同じカードで描画し、商品名の表記を揃える（色行は出ない）。
  判定は色名の完全一致。
  card_split: 色で2枚以上に分けているか。分けているときだけバリエーション画像を使う。
{%- endcomment -%}
{%- assign ci = -1 -%}
{%- for opt in product.options -%}
  {%- assign opt_lc = opt | downcase -%}
  {%- if opt == '色' or opt == 'カラー' or opt_lc == 'color' or opt_lc == 'colour' -%}
    {%- assign ci = forloop.index0 -%}
  {%- endif -%}
{%- endfor -%}
{%- assign color_names = '' -%}
{%- if ci >= 0 -%}
  {%- for v in product.variants -%}
    {%- assign n = v.options[ci] -%}
    {%- if n != blank and v.available -%}
      {%- assign wrapped = '|' | append: color_names | append: '|' -%}
      {%- assign probe = '|' | append: n | append: '|' -%}
      {%- unless wrapped contains probe -%}
        {%- if color_names == '' -%}
          {%- assign color_names = n -%}
        {%- else -%}
          {%- assign color_names = color_names | append: '|' | append: n -%}
        {%- endif -%}
      {%- endunless -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- assign color_list = color_names | split: '|' -%}
{%- assign card_split = false -%}
{%- if color_list.size > 1 -%}{%- assign card_split = true -%}{%- endif -%}
{%- if color_list.size > 0 -%}
  {%- for c in color_list -%}
    {%- assign card_variant = nil -%}
    {%- for v in product.variants -%}
      {%- if card_variant == nil and v.available and v.options[ci] == c -%}
        {%- assign card_variant = v -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if card_variant -%}
      <div class="grid__item {{ grid_item_width }}">
        {%- assign card_product = product -%}
        {%- assign card_color = c -%}
        {% include 'sumif-color-card' %}
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- else -%}
  {%- assign card_variant = product.selected_or_first_available_variant -%}
  <div class="grid__item {{ grid_item_width }}">
    {%- assign card_product = product -%}
    {%- assign card_color = '' -%}
    {% include 'sumif-color-card' %}
  </div>
{%- endif -%}
